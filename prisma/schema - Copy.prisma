generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  READ
  REVIEWED
  APPROVED
  REJECTED
}

model Department {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  parentId    Int?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")

  users       User[]

  dailyReports DailyReport[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  title       String
  description String?

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                  Int          @id @default(autoincrement())
  firstName           String
  lastName            String
  username            String       @unique
  password            String
  phone               String?
  nationalCode        String?
  positionTitle       String?

  mustChangePassword  Boolean      @default(true)
  status              UserStatus   @default(ACTIVE)

  departmentId        Int?
  department          Department?  @relation(fields: [departmentId], references: [id])

  roleId              Int?
  role                Role?        @relation(fields: [roleId], references: [id])

  managerId           Int?
  manager             User?        @relation("UserManager", fields: [managerId], references: [id])
  subordinates        User[]       @relation("UserManager")

  dailyReports        DailyReport[] @relation("DailyReportUser")
  managedDailyReports DailyReport[] @relation("DailyReportManager")
  dailyReportComments DailyReportComment[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model DailyReport {
  id              Int          @id @default(autoincrement())

  userId          Int
  user            User         @relation("DailyReportUser", fields: [userId], references: [id])

  departmentId    Int?
  department      Department?  @relation(fields: [departmentId], references: [id])

  managerId       Int?
  manager         User?        @relation("DailyReportManager", fields: [managerId], references: [id])

  reportDate      DateTime
  title           String
  content         String       @db.VarChar(500)
  problems        String?
  suggestions     String?

  status          ReportStatus @default(SUBMITTED)

  managerComment  String?
  managerActionAt DateTime?
  readAt          DateTime?

  attachments     DailyReportAttachment[]
  comments        DailyReportComment[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model DailyReportAttachment {
  id        Int         @id @default(autoincrement())

  reportId  Int
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  fileName  String
  filePath  String
  mimeType  String
  size      Int

  createdAt DateTime    @default(now())
}

model DailyReportComment {
  id        Int         @id @default(autoincrement())

  reportId  Int
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId    Int
  user      User        @relation(fields: [userId], references: [id])

  text      String      @db.VarChar(1000)

  createdAt DateTime    @default(now())
}
